// UI_Diagnose.gs — PHINOX BOS v5 Enterprise (v2)
// ============================================
// Returns: {checks: [{name, pass, detail}, ...]} — compatible with all HTML versions
// تاريخ التعديل: 2026-08-28
// ============================================

function uiDiagnose() {
  var checks = [];

  function safeStr(v) {
    if (v === null || v === undefined) return "";
    if (v instanceof Error) return "#ERROR:" + v.message;
    return String(v).trim();
  }

  function addCheck(name, pass, detail) {
    checks.push({ name: name, pass: pass, detail: safeStr(detail) });
  }

  // 1. Session
  try {
    var email = Session.getActiveUser().getEmail();
    addCheck("Session.getEmail", !!email, email || "No email");
  } catch (e) {
    addCheck("Session.getEmail", false, e.message);
  }

  // 2. Spreadsheet
  var ss = null;
  try {
    ss = SpreadsheetApp.getActiveSpreadsheet();
    addCheck("ActiveSpreadsheet", true, ss.getName());
  } catch (e) {
    addCheck("ActiveSpreadsheet", false, e.message);
    return { checks: checks };
  }

  // 3. Members Sheet
  var membersSheet = null;
  try {
    membersSheet = ss.getSheetByName("Members");
    addCheck("Members sheet exists", !!membersSheet, membersSheet ? "Rows: " + membersSheet.getLastRow() : "Not found");
  } catch (e) {
    addCheck("Members sheet exists", false, e.message);
  }

  // 4. Headers
  var emailCol = -1, roleCol = -1, statusCol = -1;
  if (membersSheet) {
    try {
      var headers = membersSheet.getRange(1, 1, 1, membersSheet.getLastColumn()).getValues()[0];
      var headersLower = headers.map(function(h) { return safeStr(h).toLowerCase(); });
      emailCol = headersLower.indexOf("email");
      roleCol = headersLower.indexOf("role");
      statusCol = headersLower.indexOf("status");
      var missing = [];
      if (emailCol === -1) missing.push("email");
      if (roleCol === -1) missing.push("role");
      addCheck("Members sheet headers", missing.length === 0,
        "Headers: [" + headers.join(", ") + "] | Missing: " + (missing.length ? missing.join(", ") : "none"));
    } catch (e) {
      addCheck("Members sheet headers", false, e.message);
    }
  }

  // 5. Email Match
  var userEmail = "";
  try { userEmail = Session.getActiveUser().getEmail(); } catch(e) {}
  if (membersSheet && emailCol !== -1 && userEmail) {
    try {
      var data = membersSheet.getDataRange().getValues();
      var found = false;
      for (var i = 1; i < data.length; i++) {
        if (safeStr(data[i][emailCol]).toLowerCase() === userEmail.toLowerCase()) {
          found = true;
          break;
        }
      }
      addCheck("User email in members", found, found ? "Found at row " + (i+1) : "Email not registered: " + userEmail);
    } catch (e) {
      addCheck("User email in members", false, e.message);
    }
  } else {
    addCheck("User email in members", false, "Cannot check — missing data");
  }

  // 6. Active Status
  if (membersSheet && statusCol !== -1 && userEmail) {
    try {
      var data = membersSheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (safeStr(data[i][emailCol]).toLowerCase() === userEmail.toLowerCase()) {
          var status = safeStr(data[i][statusCol]).toLowerCase();
          addCheck("User status active", status === "active", "Status: " + status);
          break;
        }
      }
    } catch (e) {
      addCheck("User status active", false, e.message);
    }
  } else {
    addCheck("User status active", false, "Cannot check");
  }

  // 7. Role
  try {
    var role = "GUEST";
    if (typeof Security !== "undefined" && Security.getUserRole) {
      role = Security.getUserRole();
    } else if (membersSheet && roleCol !== -1 && userEmail) {
      var data = membersSheet.getDataRange().getValues();
      for (var i = 1; i < data.length; i++) {
        if (safeStr(data[i][emailCol]).toLowerCase() === userEmail.toLowerCase()) {
          role = safeStr(data[i][roleCol]).toUpperCase() || "GUEST";
          break;
        }
      }
    }
    addCheck("User role", role !== "GUEST", "Role: " + role);
  } catch (e) {
    addCheck("User role", false, e.message);
  }

  // 8. CONFIG
  try {
    addCheck("CONFIG object", typeof CONFIG !== "undefined", typeof CONFIG !== "undefined" ? "Defined" : "Missing");
  } catch (e) {
    addCheck("CONFIG object", false, e.message);
  }

  // 9. BaseRepository
  try {
    addCheck("BaseRepository", typeof BaseRepository !== "undefined" && typeof BaseRepository.create === "function",
      typeof BaseRepository !== "undefined" ? "Available" : "Missing");
  } catch (e) {
    addCheck("BaseRepository", false, e.message);
  }

  // 10. Logger
  try {
    Logger.log("DIAGNOSE_TEST");
    addCheck("Logger.log()", true, "Works");
  } catch (e) {
    addCheck("Logger.log()", false, e.message + " — REPLACE 03_Logger.js!");
  }

  // 11. Security
  try {
    addCheck("Security module", typeof Security !== "undefined" && typeof Security.getUserRole === "function",
      typeof Security !== "undefined" ? "Loaded" : "Missing");
  } catch (e) {
    addCheck("Security module", false, e.message);
  }

  // 12. uiGetCurrentUser
  try {
    var userData = null;
    if (typeof uiGetCurrentUser === "function") {
      userData = uiGetCurrentUser();
    }
    addCheck("uiGetCurrentUser", userData && userData.email,
      userData ? "Email: " + userData.email + ", Role: " + (userData.role || "N/A") : "Returned null");
  } catch (e) {
    addCheck("uiGetCurrentUser", false, e.message);
  }

  return { checks: checks };
}
